<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A2E22"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Rotating Mesh Container -->
    <FrameLayout
        android:id="@+id/meshContainer"
        android:layout_width="1200dp"
        android:layout_height="1200dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="600dp"
            android:layout_height="600dp"
            android:layout_gravity="top|start"
            android:background="@drawable/blob_bright" />

        <View
            android:layout_width="800dp"
            android:layout_height="800dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/blob_dark" />

        <View
            android:layout_width="700dp"
            android:layout_height="700dp"
            android:layout_gravity="center"
            android:background="@drawable/blob_medium" />

        <View
            android:layout_width="500dp"
            android:layout_height="500dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="100dp"
            android:background="@drawable/blob_bright"
            android:alpha="0.4"/>
    </FrameLayout>

    <!-- CONTENT -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="50dp"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/icon_app" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/text_color"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/framd"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="Türkmenistanyň Milli Lideri,\nGahryman Arkagymyz,\nGurbanguly Berdimuhamedow"
        android:textColor="@color/text_color2"
        android:textSize="14sp"
        android:fontFamily="@font/framd"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>