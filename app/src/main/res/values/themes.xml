<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Kitaphana" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:src">#DADDE2</item>
        <item name="colorPrimary">@color/main_green</item>
        <item name="colorPrimaryVariant">@color/main_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/main_green</item>
        <item name="android:navigationBarColor">@color/main_green</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="Theme.Kitaphana" parent="Base.Theme.Kitaphana" />

    <!-- Specific theme for Splash to avoid the grey flash -->
    <style name="Theme.App.Launcher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/app_icon_c</item>
        <item name="android:statusBarColor">@color/app_icon_c</item>
        <item name="android:navigationBarColor">@color/app_icon_c</item>
    </style>
</resources>


